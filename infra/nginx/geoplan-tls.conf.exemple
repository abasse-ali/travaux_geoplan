# ============================================================
# Bloc TLS pour la production (voir infra/deploy/README.md, étape 3)
#
# Copier en geoplan-tls.conf à côté de geoplan.conf. Le certificat est
# un certificat d'origine Cloudflare (mode « Full (strict) ») monté en
# lecture seule dans /etc/nginx/tls. Le public n'entre que par ici : le
# port 80 n'est publié que sur 127.0.0.1 (HTTP_BIND), pour les
# vérifications faites depuis le serveur.
# ============================================================

server {
  listen 443 ssl;
  http2 on;
  server_name _;
  server_tokens off;
  client_max_body_size 1m;
  root /usr/share/nginx/html;

  ssl_certificate     /etc/nginx/tls/origine.pem;
  ssl_certificate_key /etc/nginx/tls/origine.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;

  # Mêmes emplacements que geoplan.conf. HSTS est posé par
  # securite.conf, inclus dans chacun (nginx n'hérite pas les
  # add_header d'un niveau à l'autre).
  include /etc/nginx/snippets/emplacements.conf;
}
