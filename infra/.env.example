# ============================================================
# Modèle de infra/.env — copier en .env, remplir, ne JAMAIS versionner.
# (infra/.gitignore l'exclut.)
# ============================================================

# --- Base ---
# Deux mots de passe longs et aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Adresse publique de l'application ---
# En production : https://…, sans barre finale. Sert à refuser les
# écritures venues d'ailleurs et à construire les liens des compagnons.
APP_ORIGIN=http://localhost:8080
NODE_ENV=production
# Le port http, publié sur HTTP_BIND seulement (127.0.0.1 : la machine
# elle-même). Ne l'ouvre au réseau qu'en connaissance de cause : Docker
# contourne ufw.
HTTP_PORT=8080
HTTP_BIND=127.0.0.1

# Mandataires de confiance devant l'API : 1, c'est-à-dire nginx, qui
# calcule lui-même l'adresse du client, Cloudflare compris
# (nginx/adresse-client.conf). Ne pas monter plus haut : l'API croirait
# alors une adresse écrite par le client.
TRUST_PROXY=1

# --- Relance du samedi ---
# a-blanc : tout est calculé et journalisé, rien n'est envoyé.
# brevo   : envoi réel ; exige BREVO_API_KEY et MAIL_FROM.
MAIL_MODE=a-blanc
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Geoffrey
MAIL_REPLY_TO=
RAPPEL_ACTIF=true

LOG_LEVEL=info
